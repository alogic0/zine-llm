int hidden(void);
```

# [JavaScript Code]($section.id('javascript'))
```javascript
/** Documentation <&>. */
export class Entry {
  #value = 1_000;
  async render(ok = true) {
    return `${this.#value} <&>\n`;
  }
}
```

Malformed:

```javascript
function broken(value { return `unfinished ${value}\n<&>
```

Incomplete alias:

```js
/* unfinished
const hidden = true;
```

# [TypeScript Code]($section.id('typescript'))
```typescript
/** Documentation <&>. */
export interface Entry<T extends object> {
  readonly value: T;
  enabled?: boolean;
}
export type Result<T> = Promise<T | null>;
```

Malformed:

```typescript
interface Broken<T extends { value: string
const text = `unfinished ${value}\n<&>
```

Incomplete alias:

```ts
type = string
```

# [YAML Code]($section.id('yaml'))
```yaml
%YAML 1.2
---
defaults: &defaults
  enabled: true
service:
  value: *defaults
  escaped: "line\n<&>"
  description: |
    first line <&>
    second line
```

Malformed:

```yaml
root:
  value: "unterminated\u12<&>
next: true
```

Incomplete alias:

```yml
text: |
  unfinished <&>
next: false
```


# [Zig Code]($section.id('zig'))
```zig
const Sample = struct {
    a: i32,
    b: i32,
};

pub extern "sampleLibrary" fn SampleFunction(
    arg1: i32,
    arg2: *Sample,
) callconv(WINAPI) BOOL;

pub inline fn main() anyerror!void {
    var sample = Sample{ .a = 1, .b = 2 };
    SampleFunction(1, &sample);
}
```

